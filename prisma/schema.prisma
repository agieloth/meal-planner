generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ingredients {
  id         Int      @id @default(autoincrement())
  recette_id Int
  nom        String   @db.VarChar(255)
  quantite   Decimal? @db.Decimal(10, 2)
  unite      String?  @db.VarChar(50)
  categorie  String?  @db.VarChar(100)
  recettes   recettes @relation(fields: [recette_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model recette_tags {
  recette_id Int
  tag_id     Int
  recettes   recettes @relation(fields: [recette_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags       tags     @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([recette_id, tag_id])
}

model recettes {
  id                Int            @id @default(autoincrement())
  nom               String         @db.VarChar(255)
  region            String         @db.VarChar(100)
  pays              String?        @db.VarChar(100)
  type_repas        String         @db.VarChar(50)
  temps_preparation Int?
  temps_cuisson     Int?
  difficulte        String?        @db.VarChar(20)
  portions          Int?
  description       String?
  instructions      String?
  created_at        DateTime?      @default(now()) @db.Timestamp(6)
  ingredients       ingredients[]
  recette_tags      recette_tags[]
}

model tags {
  id           Int            @id @default(autoincrement())
  nom          String         @unique @db.VarChar(100)
  recette_tags recette_tags[]
}